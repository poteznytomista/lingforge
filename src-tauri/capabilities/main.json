{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window: typed project commands and close-event handling. File selection stays in Rust; no general filesystem or shell API.",
  "windows": ["main"],
  "permissions": [
    "allow-application-info",
    "allow-workspace-state",
    "allow-create-project",
    "allow-open-project",
    "allow-save-project",
    "allow-close-project",
    "allow-export-project",
    "allow-import-project",
    "allow-duplicate-project",
    "allow-backup-project",
    "allow-restore-project",
    "allow-save-preferences",
    "allow-forget-project",
    "allow-lexicon-page",
    "allow-lexeme-details",
    "allow-save-lexeme",
    "allow-delete-lexeme",
    "allow-choose-lexicon-import",
    "allow-preview-lexicon-import",
    "allow-commit-lexicon-import",
    "allow-export-lexicon",
    "allow-phonology-inventory",
    "allow-phoneme-details",
    "allow-save-phoneme",
    "allow-delete-phoneme",
    "allow-save-phonology-profile",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "allow-writing-systems",
    "allow-writing-system",
    "allow-save-writing-system",
    "allow-delete-writing-system",
    "allow-preview-script-input",
    "allow-transliterate-script",
    "allow-import-glyph-outline",
    "allow-new-writing-identity",
    "allow-notebook-records",
    "allow-notebook-record",
    "allow-save-notebook-record",
    "allow-delete-notebook-record",
    "allow-edit-document-paragraph",
    "allow-convert-document-paragraph",
    "allow-document-text",
    "allow-choose-notebook-import",
    "allow-export-notebook-record",
    "allow-decode-glyph",
    "allow-edit-glyph",
    "allow-encode-glyph",
    "allow-export-glyph-outline",
    "allow-font-workspace",
    "allow-save-font-profile",
    "allow-delete-font-profile",
    "allow-preview-font",
    "allow-export-font",
    "allow-automation-index",
    "allow-automation-program",
    "allow-automation-batch",
    "allow-new-automation-identity",
    "allow-save-automation-program",
    "allow-delete-automation-program",
    "allow-preview-automation",
    "allow-apply-automation",
    "allow-revert-automation-batch"
  ]
}
